//数组逆序输出
#include <stdio.h>
int main()
{
    int i,j,z;
    int arr[10];

    printf("请输入一个数组:arr[10] = ");
    for (i = 0; i < 10; i++)
    {
        scanf("%d",&arr[i]);
        continue;
        for(j = 9; j > 0; j--)
        {
            int z = arr[i];
            int arr[i] = arr[j];
            int arr[j] = z;
            
        }
    }
    printf("数组逆序输出为:arr[10] =%d",arr[i] );

    return 0;


}

