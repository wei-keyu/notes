//函数递归：   递归中递的出口   递归的结束条件   递归的公式（每次递减1）
#include <stdio.h>
int fac(int n)
{
    if(n == 0)                          //递归结束条件
    {
        return 1;                       //递的出口
    }
    else
    {
        return n * fac(n - 1);         //递归公式
    }
}

int main()
{
    int n;
    scanf("%d",&n);
    printf("%d\n",fac(n));
    return 0;
}
//计算1+2+3+...+n的和
#include <stdio.h>
int sum(int i)
{
    if(i == 1)          //递归到1结束
    {
        return 1;       //返回1，开始归
    }
    else
    {
        return i + sum(i - 1);
    }
}
int main()
{
    int n;
    scanf("%d",&n);
    printf("%d\n",sum(n));
    return 0;
}

