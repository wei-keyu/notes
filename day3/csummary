//assert断言：在运行时确保程序符合指定条件，如果不符合，就报错终止运行
// assert(p != NULL);     如果不等于会继续运行，反正会终止报错

//  strlen()求字符串长度,统计的是字符串中\0之前的字符的个数，只要不是\0，计数器就加1
int my_strlen(const char *str)     //定义函数
{
    int a = 0;
    assert(str);             //
    while(*str)              //将str化为数组，并借助指针加减来使str的长度用a呈现
    {
        a++;
        str++;
    }
    return a;                //需要的是a的值
}
int main()
{
    int len = my_strlen("abc");        //结果为3
    printf("%d\n",len);
    return 0;
}

//传值调用：
#include <stdio.h>
void swap1(int a,int b)
{
    int tmp = a;
    a = b;
    b =tmp;
}
int main()
{
    scanf("%d%d",&x,&y);
    swap1(x,y);
    printf("x = %d,y = %d\n",x,y);
    return 0;
}        //发现并没有调换成功（实参传递给形参，形参会创建临时空间来接收实参，对形参的修改不影响实参），该功能应该用到指针定位他们的位置进行修改
#include <stdio.h>
void swap2(int *px,int *py)
{
    int tmp = *px;           //int tmp = 0;  tmp = *px;
    *px = *py;
    *py = tmp;
}
int main()
{
    int a,b;
    scanf("%d%d",&a,&b);       //&d %d
    swap2(a,b);
    printf("%d%d\n",a,b);     //%d %d
    return 0;
}           //函数的参数变成了更根源的变量的地址，调用会更加精确

