//判断year是否闰年
#include <stdio.h>
int main()
{
    int year;
    scanf("%d",&year);

    if((year%4 == 0 && year%100 != 0)  || year%400 == 0)
    {
        printf("%d是闰年",year);
    }
    else
    {
        printf("%d不是闰年");
    }
    return 0;
}

//switch
 int main()
 {
    int n;

    scanf("%d",&n);

    switch(n)                                   //n必须是整型表达式
    {
        case 1:
            printf("匹配case one");
            break;                             //break是跳出switch语句，防止继续执行下面的case，不可以省略
        case 2:                                //case后面可以跟表达式，不能跟变量，中间要有空格
            printf("匹配case two");
            break;
        case 3:
            printf("匹配case three");
            break;
        default:
            printf("未正确匹配");
            break;
    }
    return 0;
 }

