//do while循环   do{... ...}while(循环条件)  do while循环是先执行循环体再判断条件
#include <stdio.h>
int main()
{
    int i = 1;
    do
    {
        printf("%d\n",i);
        i++;
    }while(i <= 10);

    return 0;
}

//break中断循环
#include <stdio.h>
int main()
{
    int i = 1;          //空格+符号+空格

    while(i <=10)
    {
        if(i == 5)
        {
            break;
        }
        printf("%d\n",i);
        i++;
    }
    return 0;
}

